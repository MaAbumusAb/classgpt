{
  "name": "classgpt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ClassGPT monorepo - AI-powered educational assistant",
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" --parallel dev",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/**\" build && pnpm --filter \"./workers/**\" build",
    "lint": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./workers/**\" lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./workers/**\" test",
    "typecheck": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./workers/**\" typecheck",
    "clean": "pnpm --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./workers/**\" clean"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
