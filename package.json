{
  "name": "classgpt-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ClassGPT: Your Multilingual AI Study Assistant",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:frontend": "pnpm --filter @classgpt/frontend dev",
    "dev:backend": "pnpm --filter @classgpt/backend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @classgpt/frontend build",
    "build:backend": "pnpm --filter @classgpt/backend build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @classgpt/backend db:migrate",
    "db:seed": "pnpm --filter @classgpt/backend db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.11.0"
}
